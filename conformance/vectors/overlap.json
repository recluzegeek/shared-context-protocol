{
  "description": "Overlap detection (spec §6). Scopes are given raw; implementations normalize them first (§6.2). 'want' is null when the intents must not overlap; otherwise the overlap's severity and the sorted, de-duplicated set of relations among its matching pairs. Resource R is git:github.com/acme/api; C is git:github.com/acme/contracts.",
  "cases": [
    { "name": "change+change exact is high",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/http/guard.go" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/http/guard.go" }] },
      "want": { "severity": "high", "relations": ["change"] } },
    { "name": "change+change containment is normal",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/http/" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/http/guard.go" }] },
      "want": { "severity": "normal", "relations": ["change"] } },
    { "name": "remove with change is high even through containment",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/http/" }] },
      "other":   { "member": "b", "action": "remove", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/http/guard.go" }] },
      "want": { "severity": "high", "relations": ["change"] } },
    { "name": "replace with add is high",
      "subject": { "member": "a", "action": "add", "resource": "R", "scopes": [{ "kind": "symbol", "value": "shop/pay.Service.Refund" }] },
      "other":   { "member": "b", "action": "replace", "resource": "R", "scopes": [{ "kind": "symbol", "value": "shop/pay.Service" }] },
      "want": { "severity": "high", "relations": ["change"] } },
    { "name": "change+add exact is normal",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "schema", "value": "orders.total" }] },
      "other":   { "member": "b", "action": "add", "resource": "R", "scopes": [{ "kind": "schema", "value": "orders.total" }] },
      "want": { "severity": "normal", "relations": ["change"] } },
    { "name": "change+add containment is normal",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "schema", "value": "orders" }] },
      "other":   { "member": "b", "action": "add", "resource": "R", "scopes": [{ "kind": "schema", "value": "orders.discount" }] },
      "want": { "severity": "normal", "relations": ["change"] } },
    { "name": "add+add exact is normal",
      "subject": { "member": "a", "action": "add", "resource": "R", "scopes": [{ "kind": "api", "value": "post /v1/bookings" }] },
      "other":   { "member": "b", "action": "add", "resource": "R", "scopes": [{ "kind": "api", "value": "POST /v1/bookings/" }] },
      "want": { "severity": "normal", "relations": ["change"] } },
    { "name": "add+add containment is low",
      "subject": { "member": "a", "action": "add", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/http/" }] },
      "other":   { "member": "b", "action": "add", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/http/new.go" }] },
      "want": { "severity": "low", "relations": ["change"] } },
    { "name": "path containment is on whole segments",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "src/a/" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "src/ab.go" }] },
      "want": null },
    { "name": "different resources never overlap on the change side",
      "subject": { "member": "a", "action": "remove", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/http/guard.go" }] },
      "other":   { "member": "b", "action": "change", "resource": "C", "scopes": [{ "kind": "path", "value": "internal/http/guard.go" }] },
      "want": null },
    { "name": "different kinds never match",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "orders" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "schema", "value": "orders" }] },
      "want": null },
    { "name": "api parameters normalize to {}",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "api", "value": "GET /v1/bookings/{id}" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "api", "value": "get /v1/bookings/:bookingId" }] },
      "want": { "severity": "high", "relations": ["change"] } },
    { "name": "api method * contains every method and is broad, so capped at low",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "api", "value": "* /v1/bookings" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "api", "value": "POST /v1/bookings" }] },
      "want": { "severity": "low", "relations": ["change"] } },
    { "name": "rpc api exact",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "api", "value": "pay.v1.PaymentService/Charge" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "api", "value": "pay.v1.PaymentService/Charge" }] },
      "want": { "severity": "high", "relations": ["change"] } },
    { "name": "symbol containment by delimiter",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "shop/pay.Service" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "shop/pay.Service.Charge" }] },
      "want": { "severity": "normal", "relations": ["change"] } },
    { "name": "symbol prefix without delimiter does not contain",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "shop/pay.Service" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "shop/pay.ServiceImpl" }] },
      "want": null },
    { "name": "symbol languages that differ do not match",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "pay.Charge", "language": "go" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "pay.Charge", "language": "python" }] },
      "want": null },
    { "name": "symbol with one language unset matches",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "pay.Charge", "language": "go" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "pay.Charge" }] },
      "want": { "severity": "high", "relations": ["change"] } },
    { "name": "schema is case-insensitive",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "schema", "value": "Pricing.V1.Quote" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "schema", "value": "pricing.v1.quote" }] },
      "want": { "severity": "high", "relations": ["change"] } },
    { "name": "broad path containment is capped at low",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/http/guard.go" }] },
      "want": { "severity": "low", "relations": ["change"] } },
    { "name": "broad cap applies even to remove",
      "subject": { "member": "a", "action": "remove", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/http/guard.go" }] },
      "want": { "severity": "low", "relations": ["change"] } },
    { "name": "two broad scopes that are equal are an exact match, not capped",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "internal/" }] },
      "want": { "severity": "high", "relations": ["change"] } },
    { "name": "whole-package symbol containment is broad, capped at low",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "payments" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "payments.Charge" }] },
      "want": { "severity": "low", "relations": ["change"] } },
    { "name": "topic matches are capped at low",
      "subject": { "member": "a", "action": "remove", "resource": "R", "scopes": [{ "kind": "topic", "value": "Checkout" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "topic", "value": "checkout" }] },
      "want": { "severity": "low", "relations": ["change"] } },
    { "name": "a specific match keeps full severity alongside a shared topic",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "topic", "value": "checkout" }, { "kind": "symbol", "value": "shop/cart.Total" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "topic", "value": "checkout" }, { "kind": "symbol", "value": "shop/cart.Total" }] },
      "want": { "severity": "high", "relations": ["change"] } },
    { "name": "change+use exact is normal (the use row of §6.3, pinned directly)",
      "subject": { "member": "a", "action": "change", "resource": "C", "scopes": [{ "kind": "api", "value": "pay.v1.PaymentService/Charge" }] },
      "other":   { "member": "b", "action": "add", "resource": "R", "scopes": [{ "kind": "path", "value": "billing/new.go" }],
                   "uses": [{ "resource": "C", "scopes": [{ "kind": "api", "value": "pay.v1.PaymentService/Charge" }] }] },
      "want": { "severity": "normal", "relations": ["breaks"] } },
    { "name": "change+use containment is low",
      "subject": { "member": "a", "action": "change", "resource": "C", "scopes": [{ "kind": "schema", "value": "orders.total" }] },
      "other":   { "member": "b", "action": "add", "resource": "R", "scopes": [{ "kind": "path", "value": "billing/new.go" }],
                   "uses": [{ "resource": "C", "scopes": [{ "kind": "schema", "value": "orders" }] }] },
      "want": { "severity": "low", "relations": ["breaks"] } },
    { "name": "remove+use containment is high",
      "subject": { "member": "a", "action": "remove", "resource": "C", "scopes": [{ "kind": "schema", "value": "orders.total" }] },
      "other":   { "member": "b", "action": "add", "resource": "R", "scopes": [{ "kind": "path", "value": "billing/new.go" }],
                   "uses": [{ "resource": "C", "scopes": [{ "kind": "schema", "value": "orders" }] }] },
      "want": { "severity": "high", "relations": ["breaks"] } },
    { "name": "breaks: my change hits their declared use",
      "subject": { "member": "a", "action": "change", "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote.amount" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "checkout.Create" }],
                   "uses": [{ "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote.amount" }] }] },
      "want": { "severity": "normal", "relations": ["breaks"] } },
    { "name": "breaks through containment of a used message is low",
      "subject": { "member": "a", "action": "change", "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote.amount" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "checkout.Create" }],
                   "uses": [{ "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote" }] }] },
      "want": { "severity": "low", "relations": ["breaks"] } },
    { "name": "rename of a used field is high (spec §19.5)",
      "subject": { "member": "erin", "action": "rename", "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote.id", "to": "pricing.v1.Quote.quote_id" }] },
      "other":   { "member": "dana", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "checkout/booking.Create", "language": "go" }],
                   "uses": [{ "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote" }] }] },
      "want": { "severity": "high", "relations": ["breaks"] } },
    { "name": "broken_by: their change hits my declared use",
      "subject": { "member": "dana", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "checkout/booking.Create", "language": "go" }],
                   "uses": [{ "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote" }] }] },
      "other":   { "member": "erin", "action": "rename", "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote.id", "to": "pricing.v1.Quote.quote_id" }] },
      "want": { "severity": "high", "relations": ["broken_by"] } },
    { "name": "rename target matches work already using the new name",
      "subject": { "member": "a", "action": "rename", "resource": "R", "scopes": [{ "kind": "symbol", "value": "pay.Charge", "to": "pay.Capture" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "pay.Capture" }] },
      "want": { "severity": "high", "relations": ["change"] } },
    { "name": "add never breaks a use",
      "subject": { "member": "a", "action": "add", "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote.currency" }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "checkout.Create" }],
                   "uses": [{ "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote" }] }] },
      "want": null },
    { "name": "two uses of the same contract never overlap",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "checkout.Create" }],
                   "uses": [{ "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote" }] }] },
      "other":   { "member": "b", "action": "change", "resource": "R", "scopes": [{ "kind": "symbol", "value": "billing.Invoice" }],
                   "uses": [{ "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote" }] }] },
      "want": null },
    { "name": "same member, same session never overlaps",
      "subject": { "member": "a", "session": "s1", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "a.go" }] },
      "other":   { "member": "a", "session": "s1", "action": "remove", "resource": "R", "scopes": [{ "kind": "path", "value": "a.go" }] },
      "want": null },
    { "name": "same member, neither with a session, never overlaps",
      "subject": { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "a.go" }] },
      "other":   { "member": "a", "action": "remove", "resource": "R", "scopes": [{ "kind": "path", "value": "a.go" }] },
      "want": null },
    { "name": "same member, two sessions overlap",
      "subject": { "member": "a", "session": "laptop", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "a.go" }] },
      "other":   { "member": "a", "session": "desktop", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "a.go" }] },
      "want": { "severity": "high", "relations": ["change"] } },
    { "name": "same member, one session and one without, overlap",
      "subject": { "member": "a", "session": "laptop", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "a.go" }] },
      "other":   { "member": "a", "action": "change", "resource": "R", "scopes": [{ "kind": "path", "value": "a.go" }] },
      "want": { "severity": "high", "relations": ["change"] } },
    { "name": "highest severity across pairs and relations wins",
      "subject": { "member": "a", "action": "change", "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote" }],
                   "uses": [{ "resource": "R", "scopes": [{ "kind": "api", "value": "pay.v1.PaymentService/Charge" }] }] },
      "other":   { "member": "b", "action": "remove", "resource": "R", "scopes": [{ "kind": "api", "value": "pay.v1.PaymentService/Charge" }],
                   "uses": [{ "resource": "C", "scopes": [{ "kind": "schema", "value": "pricing.v1.Quote.amount" }] }] },
      "want": { "severity": "high", "relations": ["breaks", "broken_by"] } }
  ]
}
